// КЛИЕНТСКИЙ КОД — ДЕМОНСТРАЦИЯ
// ========================================
class Program
{
    static void Main()
    {
        Console.WriteLine("=== ПАТТЕРН ДЕКОРАТОР: СИСТЕМА ЗАКАЗОВ В КАФЕ ===\n");

        // Заказ 1: Латте с молоком, карамелью и взбитыми сливками
        Beverage order1 = new Latte();
        order1 = new Milk(order1);
        order1 = new CaramelSyrup(order1);
        order1 = new WhippedCream(order1);

        Console.WriteLine($"Напиток: {order1.Description}");
        Console.WriteLine($"Стоимость: {order1.Cost():F2} руб.\n");

        // Заказ 2: Эспрессо с двойным сахаром и корицей
        Beverage order2 = new Espresso();
        order2 = new Sugar(order2);
        order2 = new Sugar(order2);
        order2 = new Cinnamon(order2);

        Console.WriteLine($"Напиток: {order2.Description}");
        Console.WriteLine($"Стоимость: {order2.Cost():F2} руб.\n");

        // Заказ 3: Мокко с ванилью и молоком
        Beverage order3 = new Mocha();
        order3 = new VanillaSyrup(order3);
        order3 = new Milk(order3);

        Console.WriteLine($"Напиток: {order3.Description}");
        Console.WriteLine($"Стоимость: {order3.Cost():F2} руб.\n");

        Console.WriteLine("=== ПАТТЕРН АДАПТЕР: ПЛАТЕЖНЫЕ СИСТЕМЫ ===\n");

        List<IPaymentProcessor> processors = new List<IPaymentProcessor>
        {
            new PayPalPaymentProcessor(),
            new StripePaymentAdapter(),
            new QiwiPaymentAdapter()
        };

        foreach (var processor in processors)
        {
            Console.WriteLine($"Используется: {processor.GetType().Name}");
            processor.ProcessPayment(999.0);
            processor.RefundPayment(999.0, "test_txn_001");
            Console.WriteLine();
        }

        Console.WriteLine("Готово! Оба паттерна работают идеально.");
        Console.ReadKey();
    }
}
