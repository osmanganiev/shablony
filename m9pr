# ------------------------------
# Подсистема бронирования номеров
# ------------------------------

class RoomBookingSystem:
    def check_availability(self, room_type):
        print(f"[RoomBooking] Проверка доступности номера типа: {room_type}")
        return True

    def book_room(self, room_type, guest_name):
        print(f"[RoomBooking] Бронирование номера '{room_type}' для {guest_name}")

    def cancel_booking(self, guest_name):
        print(f"[RoomBooking] Отмена бронирования для {guest_name}")


# ------------------------------
# Подсистема ресторана
# ------------------------------

class RestaurantSystem:
    def reserve_table(self, guest_name, time):
        print(f"[Restaurant] Стол для {guest_name} забронирован на {time}")

    def order_food(self, guest_name, dishes):
        print(f"[Restaurant] {guest_name} заказал блюда: {', '.join(dishes)}")


# ------------------------------
# Подсистема мероприятий
# ------------------------------

class EventManagementSystem:
    def book_hall(self, event_name):
        print(f"[Event] Конференц-зал забронирован для мероприятия '{event_name}'")

    def order_equipment(self, equipment_list):
        print(f"[Event] Заказано оборудование: {', '.join(equipment_list)}")


# ------------------------------
# Система уборки
# ------------------------------

class CleaningService:
    def schedule_cleaning(self, room_number, time):
        print(f"[Cleaning] Уборка в номере {room_number} назначена на {time}")

    def request_cleaning_now(self, room_number):
        print(f"[Cleaning] Срочная уборка в номере {room_number}")


# ------------------------------
# Доп. подсистема: служба такси
# ------------------------------

class TaxiService:
    def order_taxi(self, guest_name):
        print(f"[Taxi] Такси для {guest_name} будет подано через 10 минут")


# ------------------------------
# ФАСАД
# ------------------------------

class HotelFacade:
    def __init__(self):
        self.rooms = RoomBookingSystem()
        self.restaurant = RestaurantSystem()
        self.events = EventManagementSystem()
        self.cleaning = CleaningService()
        self.taxi = TaxiService()

    # --- Сценарий 1 ---
    def book_room_with_services(self, room_type, guest_name, dishes, cleaning_time):
        if self.rooms.check_availability(room_type):
            self.rooms.book_room(room_type, guest_name)
            self.restaurant.order_food(guest_name, dishes)
            self.cleaning.schedule_cleaning(room_type, cleaning_time)
            print("[Facade] Номер забронирован с услугами ресторана и уборки\n")

    # --- Сценарий 2 ---
    def organize_event(self, event_name, equipment_list, rooms_for_guests):
        self.events.book_hall(event_name)
        self.events.order_equipment(equipment_list)
        for guest in rooms_for_guests:
            self.rooms.book_room("Стандарт", guest)
        print("[Facade] Мероприятие организовано и номера забронированы\n")

    # --- Сценарий 3 ---
    def reserve_table_with_taxi(self, guest_name, time):
        self.restaurant.reserve_table(guest_name, time)
        self.taxi.order_taxi(guest_name)
        print("[Facade] Стол забронирован и такси заказано\n")

    # --- Расширение функционала ---
    def cancel_room_booking(self, guest_name):
        self.rooms.cancel_booking(guest_name)

    def request_cleaning(self, room_number):
        self.cleaning.request_cleaning_now(room_number)


# ------------------------------
# КЛИЕНТСКИЙ КОД
# ------------------------------

if __name__ == "__main__":
    hotel = HotelFacade()

    print("\n--- Сценарий 1 ---")
    hotel.book_room_with_services(
        "Люкс", 
        "Иван Иванов", 
        ["Паста", "Салат"], 
