from abc import ABC, abstractmethod


# ------------------------------------
# Абстрактный компонент
# ------------------------------------
class OrganizationComponent(ABC):
    @abstractmethod
    def show_info(self, indent=0):
        pass

    @abstractmethod
    def get_budget(self):
        pass

    @abstractmethod
    def get_employee_count(self):
        pass


# ------------------------------------
# Лист — сотрудник
# ------------------------------------
class Employee(OrganizationComponent):
    def __init__(self, name, position, salary):
        self.name = name
        self.position = position
        self.salary = salary

    def set_salary(self, new_salary):
        self.salary = new_salary

    def show_info(self, indent=0):
        print(" " * indent + f"- {self.name} ({self.position}) — {self.salary} руб.")

    def get_budget(self):
        return self.salary

    def get_employee_count(self):
        return 1


# ------------------------------------
# Лист — контракор (не входит в бюджет)
# ------------------------------------
class Contractor(OrganizationComponent):
    def __init__(self, name, service, fixed_pay):
        self.name = name
        self.service = service
        self.fixed_pay = fixed_pay

    def show_info(self, indent=0):
        print(" " * indent + f"- {self.name} [Контрактор] ({self.service}) — фикс. {self.fixed_pay} руб.")

    def get_budget(self):
        return 0  # не влияет на бюджет отдела

    def get_employee_count(self):
        return 0  # не является сотрудником штата


# ------------------------------------
# Компоновщик — отдел
# ------------------------------------
class Department(OrganizationComponent):
    def __init__(self, name):
        self.name = name
        self.components = []

    def add(self, component: OrganizationComponent):
        self.components.append(component)

    def remove(self, component: OrganizationComponent):
        self.components.remove(component)

    def show_info(self, indent=0):
        print(" " * indent + f"[Отдел: {self.name}]")
        for c in self.components:
            c.show_info(indent + 4)

    def get_budget(self):
        return sum(c.get_budget() for c in self.components)

    def get_employee_count(self):
        return sum(c.get_employee_count() for c in self.components)

    # поиск сотрудника по имени
    def find_employee(self, name):
        for c in self.components:
            if isinstance(c, Employee) and c.name == name:
                return c
            if isinstance(c, Department):
                result = c.find_employee(name)
                if result:
                    return result
        return None

    # вернуть список всех сотрудников отдела и подотделов
    def get_all_employees(self):
        result = []
        for c in self.components:
            if isinstance(c, Employee):
                result.append(c)
            if isinstance(c, Department):
                result.extend(c.get_all_employees())
        return result


# ------------------------------------
# КЛИЕНТСКИЙ КОД
# ------------------------------------
if __name__ == "__main__":
    # Создаём сотрудников
    emp1 = Employee("Иван", "Разработчик", 120000)
    emp2 = Employee("Мария", "Тестировщик", 90000)
    emp3 = Employee("Олег", "Менеджер", 150000)

    contractor1 = Contractor("Сергей", "Дизайн", 80000)

    # Создаём отделы
    it_department = Department("IT")
    qa_department = Department("QA")
    main_department = Department("Главный департамент")

    # Строим иерархию
    it_department.add(emp1)
    qa_department.add(emp2)
    it_department.add(contractor1)
    main_department.add(emp3)
    main_department.add(it_department)
    main_department.add(qa_department)

    # Отображаем структуру
    print("\n--- Структура организации ---")
    main_department.show_info()

    # Бюджет
    print("\nОбщий бюджет:", main_department.get_budget(), "руб.")

    # Штат
    print("Общее количество сотрудников:", main_department.get_employee_count())

    # Поиск сотрудника
    print("\n--- Поиск сотрудника 'Мария' ---")
    found = main_department.find_employee("Мария")
    if found:
        found.show_info()

    # Все сотрудники отдела
    print("\n--- Все сотрудники Главного департамента ---")
    for e in main_department.get_all_employees():
        print("-", e.name)
